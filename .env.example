# --- Database ---
# Used when running the backend on your host (uv run ...). docker compose overrides the host to `db`.
DATABASE_URL=postgresql+psycopg://jobbear:jobbear@localhost:5432/jobbear
TEST_DATABASE_URL=postgresql+psycopg://jobbear:jobbear@localhost:5432/jobbear_test

# --- Auth (single user) ---
# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ADMIN_EMAIL=you@example.com
# Generate: uv run python -c "from pwdlib import PasswordHash; print(PasswordHash.recommended().hash('your-password'))"
# Wrap in single quotes: argon2 hashes contain `$`.
ADMIN_PASSWORD_HASH='change-me'

# --- Integrations ---
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_SECRETS_PATH=./secrets/client_secret.json

# --- Jobs ---
SCHEDULER_ENABLED=false
GMAIL_SYNC_INTERVAL_MINUTES=60
GHOSTED_AFTER_DAYS=21
WEEKLY_GOAL=35

# --- HTTP ---
# JSON list of origins allowed to call the API. In production, add your Cloudflare Pages URL.
CORS_ORIGINS='["http://localhost:5173"]'

# --- Frontend ---
VITE_API_URL=http://localhost:8000
